# EDMO DI LLM Backend Configuration
PORT=3000
NODE_ENV=development

# LLM Provider Configuration
LLM_PROVIDER=lmstudio

# LM Studio Provider Configuration
LM_STUDIO_BASE_URL=http://192.168.0.104:1234/v1
LM_STUDIO_MODEL=qwen3-8b-mlx
LLM_API_KEY=sk-lm-j7TBVCxu:9Ezf4koY3fLCgqJ5Khla

# Ollama Provider Configuration (Alternative)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# LLM Hyperparameters
LLM_TEMPERATURE=0
LLM_TOP_P=0.8
LLM_TIMEOUT_MS=300000
LLM_MAX_RETRIES=2
LLM_THINKING=false

# Prompts & Extraction
PROMPT_VERSION=transcript.v1
CONTEXT_VALIDATION_STRICT_LOSS=true

# C++ Engine & Orchestrator Configuration
EDMO_OCR_BINARY=../OCR Layer/build/bin/edmo-ocr
EDMO_EVIDENCE_BINARY=../edmo-evidence-engine/build/bin/edmo-evidence
EDMO_WORK_DIR=/tmp/edmo
EDMO_OCR_TIMEOUT_MS=120000
EDMO_EVIDENCE_TIMEOUT_MS=30000
EDMO_EVIDENCE_LLM_THRESHOLD=0.95
EDMO_DEFAULT_DPI=200
EDMO_MAX_FILE_SIZE_MB=50
EDMO_KEEP_ARTIFACTS=false
EDMO_LLM_ENABLED=true

# Storage & Privacy
RESULTS_DIR=./results
PERSIST_RAW_RESPONSE=true
LOG_LEVEL=info
